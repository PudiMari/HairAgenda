# Database Configuration
DB_USER=hairadmin
DB_PASSWORD=hairpass
DB_NAME=hairagenda

# Ports Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-safe-key-for-prod
DEBUG=True

# Observability Configuration (Grafana Cloud / OpenTelemetry)
# Backend (Direct OTLP)
OTEL_SERVICE_NAME=hairagenda-backend
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64_credentials>"
OTEL_PYTHON_DJANGO_INSTRUMENT=True

# Frontend (Grafana Faro - Solves CORS for browsers)
VITE_FARO_URL=https://faro-collector-prod-sa-east-1.grafana.net/collect/<token>
VITE_FARO_APP_NAME=HairAgenda

# Sentry Configuration
SENTRY_DSN=
